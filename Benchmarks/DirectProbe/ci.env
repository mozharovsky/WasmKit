# Parameters of the CI run of the direct-execution probe. Changing them starts a new run.
PROBE_ONLY=verify,spin,warm,latency,regression,cold,wasmi
PROBE_VARIANTS=token,token-control,direct,direct-control
PROBE_PROCESSES=3
PROBE_ROUNDS=8
PROBE_SAMPLES=5
PROBE_WARMUP=2
PROBE_COLD=10
PROBE_WASMI_ROUNDS=4
PROBE_WASMI_WARMUP_MS=500
PROBE_WASMI_MEASURE_MS=1000
PROBE_SIZES=--scale 4 --batch 2000 --chatter 100000 --action-rounds 12
PROBE_REGRESSION_PAIRS=3
PROBE_LATENCY_SAMPLES=40
# The runtime changed in the controlled direct prototype, so the suite and sanitizers run again.
RUN_RELEASE_SUITE=1
RUN_SANITIZERS=1
